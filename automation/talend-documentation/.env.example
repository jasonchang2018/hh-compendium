# Example environment configuration for this toolkit.
# Copy to .env and fill in real values — .env is gitignored, this file is not.
# Every value below is a FAKE placeholder. Never commit real credentials.
#
# See README.md's Quick Start for the full flag/env-var reference per stage.
# Every var can also be passed as a CLI flag instead; env vars are just the
# convenient default (loaded via python-dotenv's load_dotenv() in each script).

# -----------------------------------------------------------------------------
# Step 1: Talend Extractor (src/talend/talend_extractor.py)
# -----------------------------------------------------------------------------

# Workspace directory input (Mode A). Omit if you're passing the workspace
# path/archive/git URL as a CLI argument instead.
TALEND_STUDIO_WORKSPACE_PATH="/path/to/talend-workspace"

# Where the extracted metadata JSON is written / read from by later stages.
TALEND_METADATA_PATH="./full-documentation/output/talend_metadata.json"

# Mode B (archive input) / Mode C (git input) working directory.
TALEND_ARCHIVE_WORKING_DIR="./full-documentation/working"

# Where extraction-report.json is written.
TALEND_EXTRACTION_REPORT_PATH="./full-documentation/output/talend-extraction-report.json"

# Mode C only: git repo URL input requires a branch (no default, must be explicit).
TALEND_GIT_BRANCH="main"

# Mode C, HTTPS auth: name of the env var holding the token (defaults to
# TALEND_GIT_TOKEN if unset), then that env var itself.
TALEND_GIT_TOKEN_ENV_VAR="TALEND_GIT_TOKEN"
TALEND_GIT_TOKEN="ghp_FAKEtoken1234567890abcdefghijklmnop"

# Mode C, SSH auth: name of the env var holding the key path (defaults to
# TALEND_GIT_SSH_KEY_PATH if unset), then that env var itself.
TALEND_GIT_SSH_KEY_PATH_ENV_VAR="TALEND_GIT_SSH_KEY_PATH"
TALEND_GIT_SSH_KEY_PATH="/home/example-user/.ssh/id_ed25519"

# -----------------------------------------------------------------------------
# Step 2: Talend Cloud Extractor (src/talend/talend_cloud_extractor.py) — optional
# -----------------------------------------------------------------------------

# Disabled by default — must be explicitly enabled.
TALEND_CLOUD_EXTRACTOR_ENABLED="false"

TALEND_CLOUD_BASE_URL="https://api.eu.cloud.talend.com"
TALEND_STUDIO_ACCESS_TOKEN="fake-personal-access-token-0000000000000000"
TALEND_CLOUD_METADATA_PATH="./full-documentation/output/talend_cloud_metadata.json"

# -----------------------------------------------------------------------------
# Step 3: Qlik Cloud Extractor (src/qlik/qlik_cloud_extractor.py) — optional
# -----------------------------------------------------------------------------

# Disabled by default — must be explicitly enabled.
QLIK_EXTRACTOR_ENABLED="false"

QLIK_API_KEY="fake.qlik.api.key.eyJhbGciOiJFUzM4NCJ9.FAKE.PAYLOAD"
QLIK_TENANT_URL="https://your-tenant.eu.qlikcloud.com/"
QLIK_METADATA_PATH="./full-documentation/output/qlik_metadata.json"

# -----------------------------------------------------------------------------
# Steps 4-5: Documentation Generation / Deterministic Enrichment
# (src/documentation/generate_documentation.py, enrich_documentation.py)
# -----------------------------------------------------------------------------

OUTPUT_DOCUMENTATION_PATH="./documentation"

# -----------------------------------------------------------------------------
# Step 6: Automated AI Enrichment (src/documentation/ai_enrich_documentation.py)
# — optional
# -----------------------------------------------------------------------------

# Disabled by default — must be explicitly enabled. Falls back to the manual
# AI_DOCUMENTATION_PROMPT.md workflow when off.
AI_ENRICHMENT_ENABLED="false"

# Required only when AI_ENRICHMENT_ENABLED=true. Never stored in config/llm.yaml.
ANTHROPIC_API_KEY="sk-ant-api03-FAKE0000000000000000000000000000"

# Optional override for the LLM config file path (default: config/llm.yaml).
AI_ENRICHMENT_CONFIG="config/llm.yaml"

# -----------------------------------------------------------------------------
# Step 8: Publish Documentation to a Docs Repo (src/documentation/publish_docs.py)
# — optional
# -----------------------------------------------------------------------------

DOCS_REPO_URL="https://github.com/your-org/docs-repo.git"
DOCS_REPO_BRANCH="main"
DOCS_REPO_LOCAL_PATH="full-documentation/docs-repo-working"
DOCS_REPO_SOURCE_DIR="documentation"
DOCS_REPO_PROJECT_SUBDIR=""
DOCS_REPO_COMMIT_MESSAGE="docs: update documentation"

# HTTPS auth: name of the env var holding the token (defaults to
# DOCS_REPO_GIT_TOKEN if unset), then that env var itself.
DOCS_REPO_GIT_TOKEN_ENV_VAR="DOCS_REPO_GIT_TOKEN"
DOCS_REPO_GIT_TOKEN="ghp_FAKEtoken0987654321zyxwvutsrqponmlk"

# SSH auth: name of the env var holding the key path (defaults to
# DOCS_REPO_GIT_SSH_KEY_PATH if unset), then that env var itself.
DOCS_REPO_GIT_SSH_KEY_PATH_ENV_VAR="DOCS_REPO_GIT_SSH_KEY_PATH"
DOCS_REPO_GIT_SSH_KEY_PATH="/home/example-user/.ssh/id_ed25519_docs"

# Git commit identity for the publish stage — only needed if a global git
# identity (git config user.name/user.email) isn't already configured in the
# environment this runs in.
GIT_AUTHOR_NAME="Example User"
GIT_AUTHOR_EMAIL="example.user@example.com"
GIT_COMMITTER_NAME="Example User"
GIT_COMMITTER_EMAIL="example.user@example.com"

# -----------------------------------------------------------------------------
# run_pipeline.py (runs Steps 1-8 in one command)
# -----------------------------------------------------------------------------

# Directory for intermediate JSON metadata shared across pipeline stages.
PIPELINE_WORKING_DIR="full-documentation/output"
